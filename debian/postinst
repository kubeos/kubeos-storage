#!/bin/sh
# KubeOS storage, postinst: make sure the pod-data mount can never block a boot.
#
# WHY    Until 1.0.0-1kubeos3 the fstab line for /opt/local-path-provisioner had no "nofail".
#        Pod data is the only thing that mount holds, and when the thin pool fails to activate
#        - a hard power cut is enough - systemd waited for the device and dropped the machine
#        into emergency mode: a container platform that would not boot because *dynamic
#        storage* was missing. kubeos-storage-init writes the corrected line from now on, but
#        it only runs at first boot, so an existing node needs this one-time repair.
# SAFE   It only touches the single /etc/fstab line whose mountpoint is
#        /opt/local-path-provisioner, and only to add what is missing. Re-running is a no-op,
#        and a machine without that line is left alone.
set -e

# debhelper inserts its generated snippets here (systemd enable/reload, dpkg-maint-script
# helpers). It must sit before this script's own exits, otherwise they never run - that is
# exactly how every KubeOS package ended up with units debhelper never enabled.
#DEBHELPER#

MOUNT=/opt/local-path-provisioner
FSTAB=/etc/fstab
warn() { printf 'kubeos-storage: WARNING: %s\n' "$*" >&2; }

case "${1:-}" in
    configure) : ;;
    *) exit 0 ;;
esac

# A .wants link shipped in the package starts a timer only when timers.target is next
# activated - that is, at the NEXT boot. Measured 2026-11-20 on a fresh install of
# 1.0.0-12: the unit, the link and `systemctl cat` were all right, and `systemctl
# list-timers` showed nothing, so the sweep would not have existed until a reboot. Start
# it now; the shipped link keeps it enabled on every future boot.
if [ -d /run/systemd/system ]; then
    systemctl start kubeos-storage-gc.timer 2>/dev/null ||
        warn "could not start kubeos-storage-gc.timer (it will start at the next boot)"
fi

[ -f "$FSTAB" ] || exit 0
# Commented lines are not a mount: a user may have disabled the mount by hand while
# recovering, and silently re-enabling it - or worse, reporting that it is now "fixed" -
# is exactly the kind of surprise this package must not produce. Both greps below therefore
# read $FSTAB explicitly: a grep without a file argument reads STDIN, and in a live-build
# chroot stdin is the terminal, which hung the first ISO build for 10 minutes at
# "Setting up kubeos-storage" (measured 2026-11-19).
grep -qE "^[^#][^ ]*[[:space:]]+${MOUNT}[[:space:]]" "$FSTAB" || {
    printf 'kubeos-storage: %s is not in /etc/fstab (no active line); leaving it alone\n' "$MOUNT"
    exit 0
}

line=$(grep -E "^[^#][^ ]*[[:space:]]+${MOUNT}[[:space:]]" "$FSTAB" | head -n 1)
case "$line" in
    *nofail*) printf 'kubeos-storage: %s already has nofail\n' "$MOUNT" ; exit 0 ;;
esac

tmp=/etc/.fstab.kubeos-storage.new
awk -v mount="$MOUNT" '
    $0 !~ /^#/ && $2 == mount && $0 !~ /nofail/ {
        $4 = $4 ",nofail,x-systemd.device-timeout=30s"
        if ($5 == "2") $5 = "0"
        if ($6 == "2") $6 = "0"
    }
    { print }
' "$FSTAB" > "$tmp" || { warn "could not rewrite $FSTAB"; rm -f "$tmp"; exit 0; }
cat "$tmp" > "$FSTAB"
rm -f "$tmp"
systemctl daemon-reload 2>/dev/null || true
printf 'kubeos-storage: %s now mounts with nofail (a missing pool can no longer block boot)\n' "$MOUNT"
exit 0
